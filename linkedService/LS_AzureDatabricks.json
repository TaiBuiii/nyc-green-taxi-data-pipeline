{
	"name": "LS_AzureDatabricks",
	"properties": {
		"parameters": {
			"databrick_workspace_url": {
				"type": "string",
				"defaultValue": "https://adb-7405616972863473.13.azuredatabricks.net"
			},
			"select_cluster": {
				"type": "string",
				"defaultValue": "12.2.x-scala2.12"
			},
			"cluster_node_type": {
				"type": "string",
				"defaultValue": "Standard_DS3_v2"
			},
			"key_vault_name": {
				"type": "string",
				"defaultValue": "key-vault-nyc-green-taxi"
			},
			"databrick_access_token_secret_name": {
				"type": "string",
				"defaultValue": "databricks-token"
			}
		},
		"annotations": [],
		"type": "AzureDatabricks",
		"typeProperties": {
			"domain": "@linkedService().databrick_workspace_url",
			"accessToken": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "LS_AzureKeyVault",
					"type": "LinkedServiceReference",
					"parameters": {
						"key_vault_name": {
							"value": "@linkedService().key_vault_name",
							"type": "Expression"
						}
					}
				},
				"secretName": {
					"value": "@linkedService().databrick_access_token_secret_name",
					"type": "Expression"
				}
			},
			"newClusterNodeType": "@linkedService().cluster_node_type",
			"newClusterNumOfWorker": "1:3",
			"newClusterSparkEnvVars": {
				"PYSPARK_PYTHON": "/databricks/python3/bin/python3"
			},
			"newClusterVersion": "@linkedService().select_cluster",
			"clusterOption": "Autoscaling",
			"newClusterInitScripts": []
		}
	}
}