{
	"name": "pipeline",
	"properties": {
		"activities": [
			{
				"name": "Lookup Ingestion Metadata",
				"description": "",
				"type": "Lookup",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT year, month\nFROM dbo.green_taxi_control\nWHERE enabled = 1\nORDER BY year, month",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "For Each Year And Month Bronze",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Lookup Ingestion Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup Ingestion Metadata').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy Raw Trip Data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "ParquetSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "ParquetReadSettings"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_TaxiData",
									"type": "DatasetReference",
									"parameters": {
										"year": "@item().year",
										"month": {
											"value": "@item().month",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_AzureDataLakeStorage",
									"type": "DatasetReference",
									"parameters": {
										"year": "@item().year",
										"month": "@item().month",
										"storage_name": {
											"value": "@pipeline().parameters.p_DatabaseName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "For Each Year And Month Silver",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "For Each Year And Month Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Lookup Ingestion Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup Ingestion Metadata').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Transform Silver Trip Data",
							"type": "DatabricksSparkPython",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pythonFile": "databricks/src/silver/trips.py",
								"parameters": [
									"year",
									"month"
								]
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureDatabricks",
								"type": "LinkedServiceReference",
								"parameters": {
									"databrick_workspace_url": {
										"value": "@pipeline().parameters.p_DatabrickWorkspaceURL",
										"type": "Expression"
									},
									"select_cluster": {
										"value": "@pipeline().parameters.p_SelectCluster",
										"type": "Expression"
									},
									"cluster_node_type": {
										"value": "@pipeline().parameters.p_ClusterNodeType",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "For Each Files",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@split('trip_zone,trip_payment,trip_type', ',')",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy Reference Data Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_SourceReferenceData",
									"type": "DatasetReference",
									"parameters": {
										"filename": {
											"value": "@{item()}.csv",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_SinkReferenceData",
									"type": "DatasetReference",
									"parameters": {
										"folder_name": {
											"value": "@item()",
											"type": "Expression"
										},
										"file_name": {
											"value": "@item()",
											"type": "Expression"
										},
										"storage_name": {
											"value": "@pipeline().parameters.p_DatabaseName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"p_StorageAccountName": {
				"type": "string",
				"defaultValue": "datalakenycgreentaxi"
			},
			"p_KeyVaultName": {
				"type": "string",
				"defaultValue": "key-vault-nyc-green-taxi"
			},
			"p_DatabaseName": {
				"type": "string",
				"defaultValue": "datalakenycgreentaxi"
			},
			"p_DatabrickWorkspaceURL": {
				"type": "string",
				"defaultValue": "https://adb-7405616972863473.13.azuredatabricks.net"
			},
			"p_SelectCluster": {
				"type": "string",
				"defaultValue": "12.2.x-scala2.12"
			},
			"p_ClusterNodeType": {
				"type": "string",
				"defaultValue": "Standard_DS3_v2"
			}
		},
		"annotations": []
	}
}