								},
								"parameters": [
									"year",
									"month"
								]
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureDatabricks",
								"type": "LinkedServiceReference",
								"parameters": {
									"databrick_workspace_url": {
										"value": "@pipeline().parameters.p_DatabrickWorkspaceURL",
