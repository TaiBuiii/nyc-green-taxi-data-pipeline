									},
									"key_vault_name": {
										"value": "@pipeline().parameters.p_KeyVaultName",
										"type": "Expression"
									},
									"databrick_access_token_secret_name": {
										"value": "@pipeline().parameters.kv_DatabrickAccessTokenSecretName",
										"type": "Expression"
									}
